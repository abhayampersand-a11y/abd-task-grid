// TaskFlow Pro — group-based task management
// Prisma 7: no `url` in datasource (see prisma.config.ts); runtime uses @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  NEW_COMMENT
  GROUP_INVITATION
}

enum ActivityType {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  PROGRESS_UPDATED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  DESCRIPTION_UPDATED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  MEMBER_ADDED
  GROUP_CREATED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  mobile       String     @unique
  passwordHash String
  avatarUrl    String?
  jobTitle     String?
  bio          String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships         GroupMember[]
  invitesReceived     GroupInvitation[] @relation("InvitationInvitee")
  invitesSent         GroupInvitation[] @relation("InvitationInvitedBy")
  groupsCreated   Group[]          @relation("GroupCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskCreatedBy")
  comments        TaskComment[]
  attachments     TaskAttachment[]
  activities      Activity[]
  notifications   Notification[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Group {
  id          String          @id @default(cuid())
  name        String
  description String?
  visibility  GroupVisibility @default(PRIVATE)
  colorKey    String          @default("indigo")
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   User              @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  invitations GroupInvitation[]
  tasks       Task[]
  activities  Activity[]

  @@index([createdById])
  @@index([createdAt])
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/**
 * A join request the owner sends to one user. Membership is only created when
 * the invitee accepts, so `GroupMember` still means "actually in the group".
 * One row per (group, user) — re-inviting somebody who declined flips the same
 * row back to PENDING rather than piling up history.
 */
model GroupInvitation {
  id          String           @id @default(cuid())
  groupId     String
  inviteeId   String
  invitedById String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee   User  @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@index([groupId, status])
}

model Task {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  progress    Int          @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdById String
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]
  checklist   ChecklistItem[]
  activities  Activity[]

  @@index([groupId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  name         String
  url          String
  sizeBytes    Int      @default(0)
  mimeType     String   @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  label    String
  done     Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  actorId   String
  taskId    String?
  groupId   String?
  createdAt DateTime     @default(now())

  actor User   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([groupId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}
