// TaskFlow Pro — group-based task management
// Prisma 7: no `url` in datasource (see prisma.config.ts); runtime uses @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
  LINKEDIN
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  NEW_COMMENT
  GROUP_INVITATION
}

enum ActivityType {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  PROGRESS_UPDATED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  DESCRIPTION_UPDATED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  MEMBER_ADDED
  GROUP_CREATED
}

/// `mobile` and `passwordHash` are both optional because an account created
/// through a social provider has neither: the provider never gives us a phone
/// number, and there is no password to hash. Password sign-in checks for a
/// hash before verifying, and the profile screen lets the user fill the number
/// in later.
model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  mobile       String?    @unique
  passwordHash String?
  avatarUrl    String?
  /// R2 object key behind `avatarUrl`, kept so the old file can be deleted
  /// when the picture changes. Null when the URL is not ours — an OAuth
  /// provider's photo, or one pasted by hand — which we must not delete.
  avatarKey    String?
  jobTitle     String?
  bio          String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  oauthAccounts       OAuthAccount[]
  memberships         GroupMember[]
  invitesReceived     GroupInvitation[] @relation("InvitationInvitee")
  invitesSent         GroupInvitation[] @relation("InvitationInvitedBy")
  groupsCreated   Group[]          @relation("GroupCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskCreatedBy")
  comments        TaskComment[]
  attachments     TaskAttachment[]
  activities      Activity[]
  notifications   Notification[]
  pushTokens      PushToken[]

  /// The member directory filters on role + status and sorts by name; the
  /// admin table filters on role and sorts by signup date. Both are served
  /// start to finish by one of these.
  @@index([role, status, fullName])
  @@index([role, createdAt(sort: Desc)])
  /// `contains` compiles to ILIKE '%q%', which no B-tree can answer — it
  /// degrades into a full scan the moment the table is big. A trigram GIN
  /// index makes those searches index scans instead. Needs the pg_trgm
  /// extension, created by the migration that adds these.
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([jobTitle(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin)
}

/**
 * One row per (provider, account) pair a user has signed in with, so the same
 * person can attach Google *and* Microsoft to one TaskFlow account. The
 * provider's own subject id is the join key — emails change, `sub` does not.
 */
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  /// Whatever the provider called the account, for "Connected as …" copy.
  email             String?
  createdAt         DateTime      @default(now())
  lastUsedAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Group {
  id          String          @id @default(cuid())
  name        String
  description String?
  visibility  GroupVisibility @default(PRIVATE)
  colorKey    String          @default("indigo")
  /// Uploaded group picture. Null means the card falls back to `colorKey` and
  /// the first letter of the name, which every group always has.
  iconUrl     String?
  /// R2 object key behind `iconUrl`, kept so the old file can be deleted when
  /// the icon changes. Same contract as `User.avatarKey`.
  iconKey     String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   User              @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  invitations GroupInvitation[]
  tasks       Task[]
  activities  Activity[]

  @@index([createdById])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  /// Covers the `members: { some: { userId } }` semi-join every scoped query
  /// runs: both columns are in the index, so it never touches the table.
  @@index([userId, groupId])
}

/**
 * A join request the owner sends to one user. Membership is only created when
 * the invitee accepts, so `GroupMember` still means "actually in the group".
 * One row per (group, user) — re-inviting somebody who declined flips the same
 * row back to PENDING rather than piling up history.
 */
model GroupInvitation {
  id          String           @id @default(cuid())
  groupId     String
  inviteeId   String
  invitedById String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee   User  @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@index([groupId, status])
}

model Task {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  progress    Int          @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdById String
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]
  checklist   ChecklistItem[]
  activities  Activity[]

  /// Every list and counter in the app scopes tasks by assignee or by group
  /// first, then narrows on status/dueDate and sorts by createdAt. Each index
  /// below matches one of those shapes end to end, so Postgres never has to
  /// sort or filter rows it has already read.
  @@index([assigneeId, status])
  @@index([assigneeId, dueDate])
  @@index([assigneeId, createdAt(sort: Desc)])
  @@index([groupId, status])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([status])
  @@index([dueDate])
  /// Both halves of the search `OR` need an index of their own: leave one out
  /// and Postgres falls back to a sequential scan for the whole condition.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  name         String
  url          String
  sizeBytes    Int      @default(0)
  mimeType     String   @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  label    String
  done     Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  actorId   String
  taskId    String?
  groupId   String?
  createdAt DateTime     @default(now())

  actor User   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Both feeds read the newest rows for one task or one group, so the sort
  /// column rides along in the index and the read stops after `take`.
  @@index([taskId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
}

/**
 * One row per device that has agreed to receive push. The Expo token is the
 * identity — it is unique per (app install, device), so a second person signing
 * in on the same phone moves the row to their account instead of adding one,
 * which is what stops the previous user's alerts from landing on a handset they
 * no longer own.
 *
 * Rows are disposable: Expo answers `DeviceNotRegistered` for tokens the OS has
 * revoked, and the sender deletes them on the spot.
 */
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  /// "ios" | "android" — only used for support/debugging.
  platform   String
  deviceName String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}
