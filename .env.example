# ---------------------------------------------------------------------------
# Neon Postgres
# Create a project at https://console.neon.tech and copy both strings.
# DATABASE_URL  -> pooled connection  (has "-pooler" in the host) — used at runtime
# DIRECT_URL    -> direct connection  (no "-pooler")              — used by migrations
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — 32+ random chars. Generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Seeded administrator (there is exactly one admin in the application)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@taskflow.pro"
ADMIN_MOBILE="+1 (555) 000-0001"
ADMIN_PASSWORD="Admin@12345"

# ---------------------------------------------------------------------------
# Social sign-in (Google / Microsoft / LinkedIn)
#
# APP_URL is the public origin of THIS app. Every provider's redirect URI is
# derived from it and must match the console entry byte for byte:
#
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/microsoft/callback
#   {APP_URL}/api/auth/oauth/linkedin/callback
#
# Leave a pair blank to hide that provider's button — nothing else breaks.
# ---------------------------------------------------------------------------
APP_URL="https://abd-task-grid.vercel.app"

# console.cloud.google.com -> APIs & Services -> Credentials
# -> Create OAuth client ID -> type "Web application"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# portal.azure.com -> Entra ID -> App registrations -> Certificates & secrets.
# The redirect URI platform must be "Web". MICROSOFT_TENANT_ID defaults to
# "common" (any work, school or personal account); set a tenant GUID to
# restrict sign-in to a single organisation.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# developer.linkedin.com -> your app -> Auth. The "Sign In with LinkedIn using
# OpenID Connect" product must be added to the app, or the openid/profile/email
# scopes are rejected.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
